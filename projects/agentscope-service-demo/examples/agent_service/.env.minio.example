# Copy to .env beside compose.storage.yaml and replace these values.
# Keep this file private: it grants access to every uploaded knowledge source.
MINIO_ROOT_USER=agentscope
MINIO_ROOT_PASSWORD=change-this-to-a-long-random-password
MINIO_ACCESS_KEY=agentscope
MINIO_SECRET_KEY=change-this-to-the-same-long-random-password
MINIO_BUCKET=agentscope-knowledge
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# GraphRAG (Neo4j)
NEO4J_PASSWORD=change-this-to-another-long-random-password
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
